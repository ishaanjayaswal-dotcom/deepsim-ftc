# HTTP listen port (default: 8787)
# PORT=8787

# Bind address (default: 127.0.0.1; use 0.0.0.0 in Docker)
# HOST=127.0.0.1

# libSQL database URL (default: file:./data/deepsim.db)
# DATABASE_URL=file:./data/deepsim.db

# Turso auth token (only for libsql:// URLs)
# DATABASE_AUTH_TOKEN=

# Bearer token that may edit/delete any path (optional)
# ADMIN_KEY=

# Comma-separated allowed CORS origins (unset = same-origin only, no CORS headers)
# CORS_ORIGIN=

# Trust X-Forwarded-For for client IP (default: false)
# TRUST_PROXY=false

# Seed starter paths when the paths table is empty (default: true)
# SEED=true

# Built web app directory for static hosting (default: dist when present)
# STATIC_DIR=dist
